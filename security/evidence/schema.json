{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Admisiones security evidence",
  "type": "object",
  "required": [
    "controlId",
    "application",
    "component",
    "repository",
    "commitSha",
    "source",
    "environment",
    "timestamp",
    "result"
  ],
  "properties": {
    "controlId": {
      "type": "string",
      "pattern": "^v5\\.0\\.0-[0-9]+\\.[0-9]+\\.[0-9]+$"
    },
    "application": { "const": "admisiones" },
    "component": {
      "enum": ["frontend", "backend", "system", "infrastructure"]
    },
    "repository": { "type": "string" },
    "commitSha": { "type": "string", "pattern": "^[0-9a-fA-F]{7,40}$" },
    "fingerprint": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "source": {
      "enum": [
        "sonar",
        "zap",
        "automated-test",
        "static-rule",
        "configuration",
        "agent-review",
        "human-review"
      ]
    },
    "tool": { "type": "string" },
    "toolVersion": { "type": "string" },
    "rule": { "type": "string" },
    "file": { "type": "string" },
    "line": { "type": "integer", "minimum": 1 },
    "test": { "type": "string" },
    "environment": {
      "enum": ["development", "testing", "preproduction", "production"]
    },
    "timestamp": { "type": "string", "format": "date-time" },
    "expiresAt": { "type": "string", "format": "date-time" },
    "result": { "enum": ["PASS", "FAIL", "INFORMATIONAL"] },
    "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
    "scannerSeverity": { "type": "string" },
    "notes": { "type": "string" }
  },
  "additionalProperties": false
}
