{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Admisiones security evidence",
  "type": "object",
  "required": ["controlId", "application", "component", "repository", "commitSha", "source", "timestamp", "result"],
  "properties": {
    "controlId": { "type": "string", "pattern": "^v5\\.0\\.0-[0-9]+\\.[0-9]+\\.[0-9]+$" },
    "application": { "const": "admisiones" },
    "component": { "enum": ["frontend", "backend", "system", "infrastructure"] },
    "repository": { "type": "string" },
    "commitSha": { "type": "string" },
    "source": { "enum": ["sonar", "zap", "automated-test", "static-rule", "configuration", "agent-review", "human-review"] },
    "tool": { "type": "string" },
    "toolVersion": { "type": "string" },
    "rule": { "type": "string" },
    "file": { "type": "string" },
    "line": { "type": "integer", "minimum": 1 },
    "test": { "type": "string" },
    "environment": { "enum": ["development", "testing", "preproduction", "production"] },
    "timestamp": { "type": "string", "format": "date-time" },
    "expiresAt": { "type": "string", "format": "date-time" },
    "result": { "enum": ["PASS", "FAIL", "INFORMATIONAL"] },
    "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
    "notes": { "type": "string" }
  }
}

