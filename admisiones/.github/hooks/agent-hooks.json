    "SessionStart": [
      {
        "type": "command",
        "command": "node ./scripts/ai-hooks/agent-hooks.js SessionStart"
      }
    ],
    "UserPromptSubmit": [
      {
        "type": "command",
        "command": "node ./scripts/ai-hooks/agent-hooks.js UserPromptSubmit"
      }
    ],
    "PreToolUse": [
      {
        "type": "command",
        "command": "node ./scripts/ai-hooks/agent-hooks.js PreToolUse"
      }
    ],
    "PostToolUse": [
      {
        "type": "command",
        "command": "node ./scripts/ai-hooks/agent-hooks.js PostToolUse"
