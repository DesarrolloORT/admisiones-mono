{
  "name": "admisiones",
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "start": "node ./scripts/environment.js start",
    "build": "node ./scripts/environment.js build",
    "env": "node ./scripts/environment.js sync",
    "lint": "prettier --write . && stylelint --fix **/*.scss && eslint --fix .",
    "lint:check": "prettier --check . && npm run check-disable-comments && stylelint **/*.scss && eslint . && npm run check-api-contracts && npm run check:knowledge",
    "test": "ng test --no-watch",
    "test:ci": "ng test --no-watch --no-progress --coverage --coverage-reporters lcov && npm run test:api-contracts && npm run test:knowledge",
    "test:sonar": "ng test --no-watch --coverage --coverage-reporters lcov",
    "test:coverage:flows": "ng test --no-watch --no-progress --coverage --coverage-reporters text-summary --coverage-reporters json-summary --coverage-reporters lcov --include src/app/features/auth --include src/app/features/enrollments --include src/app/core/guards --include src/app/core/interceptors --coverage-include src/app/features/auth/**/*.ts --coverage-include src/app/features/enrollments/**/*.ts --coverage-include src/app/core/guards/**/*.ts --coverage-include src/app/core/interceptors/**/*.ts --coverage-exclude **/*.spec.ts --coverage-exclude **/*.routes.ts",
    "test:a11y": "playwright test --config playwright.config.ts --grep @a11y",
    "test:e2e": "playwright test --config playwright.config.ts",
    "test:e2e:telemetry": "playwright test --config playwright.config.ts --grep @telemetry",
    "test:e2e:smoke": "playwright test --config playwright.config.ts --grep @smoke",
    "test:e2e:regression": "playwright test --config playwright.config.ts --grep @regression",
    "test:e2e:ui": "playwright test --config playwright.config.ts --ui",
    "test:e2e:report": "playwright show-report",
    "ci": "npm run lint:check && npm run test:ci && npm run build -- desa && npm run test:a11y && npm run test:e2e:smoke",
    "quality:local": "npm run lint:check && npm run check-missing-tests && npm run test:ci && npm run build -- desa",
    "check-disable-comments": "node ./scripts/quality/check-disable-comments.js",
    "check-missing-tests": "node ./scripts/testing/check-missing-tests.js",
    "check:prod-exposure": "node ./scripts/quality/check-prod-exposure.js",
    "generate-tests": "node ./scripts/testing/generate-missing-tests.js",
    "sonar:local": "node ./scripts/sonar/local-scan.js",
    "update-api": "node ./scripts/codegen/update-api.js --spec-dir .api-spec",
    "api-spec:refresh": "node ./scripts/codegen/fetch-api-spec.js --output .api-spec",
    "fix-api": "node ./scripts/codegen/api-repair.js",
    "check-api-contracts": "node ./scripts/codegen/check-api-contracts.js",
    "test:api-contracts": "node --test ./scripts/codegen/api-repair.test.js ./scripts/codegen/check-api-contracts.test.js ./scripts/codegen/update-endpoints.test.js ./scripts/codegen/update-models.test.js ./scripts/codegen/update-contracts.test.js ./scripts/codegen/fetch-api-spec.test.js ./scripts/build/inject-script-nonce.test.js",
    "check:knowledge": "node ./scripts/docs/check-knowledge.js",
    "test:knowledge": "node --test ./scripts/docs/check-knowledge.test.js",
    "docs:build": "npm run build --prefix docs-site",
    "prepare": "husky"
  },
  "private": true,
  "dependencies": {
    "@angular/animations": "^22.0.7",
    "@angular/cdk": "^22.0.5",
    "@angular/common": "^22.0.7",
    "@angular/compiler": "^22.0.7",
    "@angular/core": "^22.0.7",
    "@angular/elements": "^22.0.7",
    "@angular/forms": "^22.0.7",
    "@angular/material": "^22.0.5",
    "@angular/platform-browser": "^22.0.7",
    "@angular/platform-browser-dynamic": "^22.0.7",
    "@angular/router": "^22.0.7",
    "@desarrolloort/components": "^4.2.0",
    "@desarrolloort/design-system": "^2.1.0",
    "@desarrolloort/fdp-components": "^3.0.0",
    "@desarrolloort/ngx-utils": "^3.0.0",
    "@webcomponents/webcomponentsjs": "^2.8.0",
    "moment": "^2.30.1",
    "ng-recaptcha-2": "^21.0.1",
    "platform": "^1.3.6",
    "rxjs": "~7.8.1",
    "swiper": "^12.2.0",
    "tslib": "^2.7.0",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.2/xlsx-0.20.2.tgz"
  },
  "devDependencies": {
    "@angular-devkit/build-angular": "^22.0.7",
    "@angular-devkit/core": "^22.0.7",
    "@angular-devkit/schematics": "^22.0.7",
    "@angular-eslint/eslint-plugin": "^22.1.0",
    "@angular-eslint/eslint-plugin-template": "^22.1.0",
    "@angular-eslint/schematics": "^22.1.0",
    "@angular-eslint/template-parser": "^22.1.0",
    "@angular/build": "^22.0.7",
    "@angular/cli": "~22.0.7",
    "@angular/compiler-cli": "^22.0.7",
    "@anthropic-ai/claude-code": "2.1.220",
    "@axe-core/playwright": "^4.11.3",
    "@craftworks/stylelint-config-angular": "^6.0.7",
    "@desarrolloort/azure-env-sync": "1.1.1",
    "@eslint/eslintrc": "^3.1.0",
    "@eslint/js": "^9.10.0",
    "@openai/codex": "0.145.0",
    "@openapitools/openapi-generator-cli": "2.32.0",
    "@playwright/test": "^1.60.0",
    "@types/jest": "^30.0.0",
    "@typescript-eslint/eslint-plugin": "^8.64.0",
    "@typescript-eslint/parser": "^8.64.0",
    "@typescript-eslint/types": "^8.64.0",
    "@typescript-eslint/utils": "^8.64.0",
    "@vitest/coverage-v8": "^4.1.0",
    "angular-eslint": "^22.1.0",
    "eslint": "^9.28.0",
    "eslint-config-prettier": "^10.1.5",
    "eslint-plugin-prettier": "^5.4.1",
    "eslint-plugin-simple-import-sort": "^12.1.1",
    "husky": "^9.1.6",
    "jsdom": "^26.1.0",
    "lint-staged": "^15.2.10",
    "postcss-scss": "^4.0.9",
    "prettier": "^3.3.3",
    "prettier-eslint": "^17.1.1",
    "stylelint": "^16.20.0",
    "stylelint-config-recommended": "^16.0.0",
    "stylelint-config-standard": "^38.0.0",
    "stylelint-prettier": "^5.0.3",
    "stylelint-scss": "^6.12.0",
    "ts-node": "^10.9.2",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.64.0",
    "vitest": "^4.1.0"
  },
  "overrides": {
    "concurrently": {
      "shell-quote": "1.8.4"
    }
  },
  "lint-staged": {
    "*.{ts,html}": [
      "eslint --cache --fix --no-warn-ignored",
      "prettier --write"
    ],
    "*.{scss,md}": [
      "prettier --write"
    ],
    "*.scss": [
      "stylelint --fix"
    ]
  },
  "packageManager": "pnpm@11.5.0+sha512.dbfcc4f81cf48597afd4bc391ffdf12c11f1a9fb83a395bfa6b0a2d9cc2fd8ffebafdb1ccbd529632153f793904c2615b7f09fe1a345473fd1c35845172a8eb1"
}
