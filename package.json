{
  "name": "angular-template",
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "start": "ng serve",
    "start:dc": "ng serve --host=0.0.0.0 --disable-host-check",
    "start:o": "ng serve -o",
    "build": "ng build",
    "build:staging": "ng build --configuration staging && npm run copy-web-config",
    "build:dev": "ng build --configuration development && npm run copy-web-config",
    "copy-web-config": "cpy src/web.dev.config dist/angular-template/browser --rename=web.config --overwrite --flat",
    "ci": "npm run lint:check && npm run test && npm run build",
    "lint": "prettier --write . && stylelint --fix **/*.scss && eslint --fix .",
    "lint:check": "prettier --check . && stylelint **/*.scss && eslint .",
    "test": "ng test --no-watch",
    "test:ci": "ng test --no-watch --no-progress",
    "test:snapshot": "npm run test:ci",
    "test:watch": "ng test --watch",
    "test:sonar": "ng test --no-watch --coverage",
    "test:coverage": "ng test --no-watch --coverage",
    "test:full": "npm run test:coverage",
    "test:only-changed": "npm run test:ci",
    "generate-tests": "node ./scripts/testing/generate-missing-tests.js",
    "check-missing-tests": "node ./scripts/testing/check-missing-tests.js",
    "update-models": "java -jar tools/swagger-codegen-cli-2.4.32.jar generate -Dmodels -i [REPLACE WITH SWAGGER DOCS API URL] -l typescript-angular -o api -c tools/swagger-codegen-options.json -D io.swagger.parser.util.RemoteUrl.trustAll=true --additional-properties modelPropertyNaming=original"
  },
  "private": true,
  "dependencies": {
    "@angular/animations": "^21.2.4",
    "@angular/cdk": "^21.2.2",
    "@angular/common": "^21.2.4",
    "@angular/compiler": "^21.2.4",
    "@angular/core": "^21.2.4",
    "@angular/forms": "^21.2.4",
    "@angular/material": "^21.2.2",
    "@angular/platform-browser": "^21.2.4",
    "@angular/platform-browser-dynamic": "^21.2.4",
    "@angular/router": "^21.2.4",
    "@desarrolloort/components": "^1.1.5",
    "@desarrolloort/design-system": "^0.3.0",
    "@desarrolloort/ngx-utils": "^2.1.0",
    "@webcomponents/webcomponentsjs": "^2.8.0",
    "moment": "^2.30.1",
    "ng-recaptcha-2": "^21.0.1",
    "platform": "^1.3.6",
    "rxjs": "~7.8.1",
    "tslib": "^2.7.0",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.2/xlsx-0.20.2.tgz"
  },
  "devDependencies": {
    "@angular-devkit/build-angular": "^21.2.2",
    "@angular-devkit/core": "^21.2.2",
    "@angular-devkit/schematics": "^21.2.2",
    "@angular-eslint/eslint-plugin": "^20.7.0",
    "@angular-eslint/eslint-plugin-template": "^20.7.0",
    "@angular-eslint/schematics": "^20.7.0",
    "@angular-eslint/template-parser": "^20.7.0",
    "@angular/build": "^21.2.2",
    "@angular/cli": "~21.2.2",
    "@angular/compiler-cli": "^21.2.4",
    "@craftworks/stylelint-config-angular": "^6.0.7",
    "@eslint/eslintrc": "^3.1.0",
    "@eslint/js": "^9.10.0",
    "@typescript-eslint/eslint-plugin": "^8.29.0",
    "@typescript-eslint/parser": "^8.29.0",
    "@typescript-eslint/types": "^8.29.0",
    "@typescript-eslint/utils": "^8.29.0",
    "@vitest/coverage-v8": "^4.1.0",
    "cpy-cli": "^5.0.0",
    "eslint": "^9.28.0",
    "eslint-config-prettier": "^10.1.5",
    "eslint-plugin-prettier": "^5.4.1",
    "eslint-plugin-simple-import-sort": "^12.1.1",
    "husky": "^9.1.6",
    "jsdom": "^26.1.0",
    "lint-staged": "^15.2.10",
    "postcss-scss": "^4.0.9",
    "prettier": "^3.3.3",
    "prettier-eslint": "^16.4.2",
    "stylelint": "^16.20.0",
    "stylelint-config-recommended": "^16.0.0",
    "stylelint-config-standard": "^38.0.0",
    "stylelint-prettier": "^5.0.3",
    "stylelint-scss": "^6.12.0",
    "ts-node": "^10.9.2",
    "typescript": "5.9.3",
    "vitest": "^4.1.0"
  },
  "lint-staged": {
    "*.{ts,html}": [
      "eslint --cache --fix",
      "prettier --write"
    ],
    "*.{scss,md}": [
      "prettier --write"
    ],
    "*.scss": [
      "stylelint --fix"
    ]
  }
}
