{
  "name": "admisiones",
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "start": "ng serve",
    "start:o": "ng serve -o",
    "start:dc": "ng serve --host=0.0.0.0 --disable-host-check",
    "prestart": "npm run env:sync -- --env desa",
    "prestart:o": "npm run env:sync -- --env desa",
    "prestart:dc": "npm run env:sync -- --env desa",
    "build": "ng build",
    "build:dev": "ng build --configuration development",
    "build:staging": "ng build",
    "build:prod": "ng build --configuration production",
    "prebuild:dev": "npm run env:sync -- --env desa",
    "prebuild:prod": "npm run env:sync -- --env prod --refresh",
    "lint": "prettier --write . && stylelint --fix **/*.scss && eslint --fix .",
    "lint:check": "prettier --check . && npm run check-disable-comments && stylelint **/*.scss && eslint . && npm run check-api-contracts",
    "test": "ng test --no-watch",
    "test:watch": "ng test --watch",
    "test:ci": "ng test --no-watch --no-progress && npm run test:api-contracts",
    "test:coverage": "ng test --no-watch --coverage",
    "test:sonar": "ng test --no-watch --coverage --coverage-reporters lcov",
    "test:a11y": "playwright test --config playwright.config.ts --grep @a11y",
    "test:e2e:smoke": "playwright test --config playwright.config.ts --grep @smoke",
    "test:e2e:regression": "playwright test --config playwright.config.ts --grep @regression",
    "test:e2e:ui": "playwright test --config playwright.config.ts --ui",
    "test:e2e:report": "playwright show-report",
    "ci": "npm run lint:check && npm run test:ci && npm run build && npm run test:a11y && npm run test:e2e:smoke",
    "quality:local": "npm run lint:check && npm run check-missing-tests && npm run test:ci && npm run build:dev",
    "check-disable-comments": "node ./scripts/quality/check-disable-comments.js",
    "check-missing-tests": "node ./scripts/testing/check-missing-tests.js",
    "generate-tests": "node ./scripts/testing/generate-missing-tests.js",
    "sonar:local": "node ./scripts/sonar/local-scan.js",
    "sonar:gate-local": "node ./scripts/sonar/quality-gate-local.js",
    "update-api": "node ./scripts/codegen/update-api.js",
    "check-api-contracts": "node ./scripts/codegen/check-api-contracts.js",
    "test:api-contracts": "node --test ./scripts/codegen/check-api-contracts.test.js ./scripts/codegen/update-endpoints.test.js ./scripts/codegen/update-models.test.js ./scripts/codegen/update-contracts.test.js",
    "env:sync": "node tools/env/sync-azure-environment.mjs --project admisiones --endpoint https://appconfigurationdesarrolloia.azconfig.io",
    "env:refresh": "node tools/env/sync-azure-environment.mjs --project admisiones --endpoint https://appconfigurationdesarrolloia.azconfig.io --refresh",
    "env:offline": "node tools/env/sync-azure-environment.mjs --project admisiones --endpoint https://appconfigurationdesarrolloia.azconfig.io --offline",
    "env:cache:clear": "node tools/env/sync-azure-environment.mjs --clear-cache",
    "test:env-sync": "node tools/env/sync-azure-environment.mjs --self-test",
    "docs": "npm --prefix docs-site run",
    "docs:site": "npm --prefix docs-site run start",
    "docs:site:build": "npm --prefix docs-site run build",
    "docs:site:serve": "npm --prefix docs-site run serve",
    "prepare": "husky"
  },
  "private": true,
  "dependencies": {
    "@angular/animations": "^21.2.4",
    "@angular/cdk": "^21.2.2",
    "@angular/common": "^21.2.4",
    "@angular/compiler": "^21.2.4",
    "@angular/core": "^21.2.4",
    "@angular/forms": "^21.2.4",
    "@angular/material": "^21.2.2",
    "@angular/platform-browser": "^21.2.4",
    "@angular/platform-browser-dynamic": "^21.2.4",
    "@angular/router": "^21.2.4",
    "@desarrolloort/components": "^2.3.0",
    "@desarrolloort/design-system": "^1.3.0",
    "@desarrolloort/fdp-components": "file:desarrolloort-fdp-components-1.3.2.tgz",
    "@desarrolloort/ngx-utils": "^2.2.0",
    "@webcomponents/webcomponentsjs": "^2.8.0",
    "moment": "^2.30.1",
    "ng-recaptcha-2": "^21.0.1",
    "platform": "^1.3.6",
    "rxjs": "~7.8.1",
    "swiper": "^12.2.0",
    "tslib": "^2.7.0",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.2/xlsx-0.20.2.tgz"
  },
  "devDependencies": {
    "@angular-devkit/build-angular": "^21.2.2",
    "@angular-devkit/core": "^21.2.2",
    "@angular-devkit/schematics": "^21.2.2",
    "@angular-eslint/eslint-plugin": "^20.7.0",
    "@angular-eslint/eslint-plugin-template": "^20.7.0",
    "@angular-eslint/schematics": "^20.7.0",
    "@angular-eslint/template-parser": "^20.7.0",
    "@angular/build": "^21.2.2",
    "@angular/cli": "~21.2.2",
    "@angular/compiler-cli": "^21.2.4",
    "@axe-core/playwright": "^4.11.3",
    "@azure/app-configuration": "^1.11.0",
    "@azure/identity": "^4.13.1",
    "@craftworks/stylelint-config-angular": "^6.0.7",
    "@eslint/eslintrc": "^3.1.0",
    "@eslint/js": "^9.10.0",
    "@playwright/test": "^1.60.0",
    "@types/jest": "^30.0.0",
    "@typescript-eslint/eslint-plugin": "^8.29.0",
    "@typescript-eslint/parser": "^8.29.0",
    "@typescript-eslint/types": "^8.29.0",
    "@typescript-eslint/utils": "^8.29.0",
    "@vitest/coverage-v8": "^4.1.0",
    "cpy-cli": "^5.0.0",
    "eslint": "^9.28.0",
    "eslint-config-prettier": "^10.1.5",
    "eslint-plugin-prettier": "^5.4.1",
    "eslint-plugin-simple-import-sort": "^12.1.1",
    "husky": "^9.1.6",
    "jsdom": "^26.1.0",
    "lint-staged": "^15.2.10",
    "postcss-scss": "^4.0.9",
    "prettier": "^3.3.3",
    "prettier-eslint": "^17.1.1",
    "stylelint": "^16.20.0",
    "stylelint-config-recommended": "^16.0.0",
    "stylelint-config-standard": "^38.0.0",
    "stylelint-prettier": "^5.0.3",
    "stylelint-scss": "^6.12.0",
    "ts-node": "^10.9.2",
    "typescript": "5.9.3",
    "vitest": "^4.1.0"
  },
  "lint-staged": {
    "*.{ts,html}": [
      "eslint --cache --fix",
      "prettier --write"
    ],
    "*.{scss,md}": [
      "prettier --write"
    ],
    "*.scss": [
      "stylelint --fix"
    ]
  },
  "packageManager": "pnpm@11.5.0+sha512.dbfcc4f81cf48597afd4bc391ffdf12c11f1a9fb83a395bfa6b0a2d9cc2fd8ffebafdb1ccbd529632153f793904c2615b7f09fe1a345473fd1c35845172a8eb1"
}

