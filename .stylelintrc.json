{
  "extends": [
    "stylelint-config-recommended",
    "stylelint-prettier/recommended",
    "stylelint-scss",
    "@craftworks/stylelint-config-angular"
  ],
  "customSyntax": "postcss-scss",
  "rules": {
    "color-no-invalid-hex": true,
    "function-linear-gradient-no-nonstandard-direction": true,
    "function-no-unknown": [true, { "ignoreFunctions": ["/^map-get/", "/^math-/"] }],
    "unit-no-unknown": true,
    "property-no-unknown": [true, { "ignoreProperties": ["/^ng-/", "/^mat-/", "/^cdk-/"] }],
    "function-url-no-scheme-relative": true,
    "function-url-scheme-allowed-list": ["/^https?/", "/^data:/"],

    "color-hex-alpha": "never",
    "color-named": "never",
    "color-no-hex": null,

    "declaration-property-unit-allowed-list": {
      "font-size": ["rem", "em"],
      "line-height": ["unitless", "em", "rem"],
      "/^width/": ["%", "em", "rem", "vw", "dvw"],
      "/^height/": ["%", "em", "rem", "vh", "dvh"],
      "/^margin/": ["em", "rem", "%"],
      "/^padding/": ["em", "rem", "%"],
      "/^gap/": ["em", "rem", "%"],
      "border-radius": ["px", "%"]
    },

    "unit-disallowed-list": [
      "in",
      "cm",
      "mm",
      "pt",
      "pc",
      "q",
      "ex",
      "ch",
      "dpcm",
      "dppx",
      "Hz",
      "kHz",
      "turn"
    ],

    "selector-max-class": 5,
    "selector-max-id": 1,
    "selector-max-compound-selectors": null,
    "selector-max-pseudo-class": 3,
    "selector-max-universal": 1,

    "time-min-milliseconds": 100,
    "font-weight-notation": "numeric",

    "at-rule-no-unknown": null,
    "scss/at-rule-no-unknown": true,

    "scss/selector-no-redundant-nesting-selector": true,

    "declaration-property-value-no-unknown": null,

    "no-invalid-double-slash-comments": null,
    "no-descending-specificity": null
  },
  "ignoreFiles": ["dist/**", "node_modules/**", "coverage/**"]
}
