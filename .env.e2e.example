# Copy this file to .env.e2e.local for local assisted or real E2E runs.
# Do not commit .env.e2e.local.

# Optional: deployed frontend URL. When omitted, Playwright starts ng serve locally.
E2E_BASE_URL=

# Optional: local assisted registration document. Prefer leaving this empty and
# typing private data manually in Playwright UI/headed mode.
E2E_ASSISTED_DOCUMENT_NUMBER=

# Required only for @nightly/@real login checks against preprod.
E2E_NIGHTLY_DOCUMENT_NUMBER=
E2E_NIGHTLY_PASSWORD=
