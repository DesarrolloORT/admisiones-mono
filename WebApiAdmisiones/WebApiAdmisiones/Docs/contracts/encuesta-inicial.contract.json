{
  "version": 9,
  "request": "DtoGuardarEncuestaInicialRequest",
  "catalogSource": "Catalogos/EncuestaInicial",
  "sections": [
    {
      "key": "educacion",
      "label": "Educación",
      "fields": [
        "ubicacionUltimoAnioSecundariaId",
        "institucionSecundariaId",
        "nombreInstitucionSecundaria",
        "cursaSecundariaActualmente",
        "anioBachillerato",
        "orientacionBachilleratoId",
        "recursaAnioBachillerato",
        "vecesRecursaAnioBachillerato",
        "estadoEducacionSuperiorPreviaId",
        "universidadEducacionSuperiorIds",
        "universidadEducacionSuperiorOtros",
        "nivelFormacionPadreTutorId",
        "padreTutorEgresadoOrt",
        "nivelFormacionMadreTutorId",
        "madreTutorEgresadoOrt"
      ]
    },
    {
      "key": "decisionAcademica",
      "label": "Decisión académica",
      "fields": [
        "anioDecisionCarreraId",
        "anioDecisionOrtId",
        "nivelDecisionId",
        "seInformoEnOtrasUniversidades",
        "universidadConsideradaIds",
        "universidadConsideradaOtros",
        "informacionOtrasUniversidadesLinea1",
        "informacionOtrasUniversidadesLinea2",
        "apoyoDecisionId",
        "motivoEleccionOrtIds"
      ]
    },
    {
      "key": "experienciaOrt",
      "label": "Experiencia con ORT",
      "fields": [
        "tuvoAsesoramientoOrt",
        "valoracionAsesoramientoOrtId",
        "visitoSitioWebOrt",
        "valoracionSitioWebOrtId",
        "visitoInstalacionesOrt",
        "valoracionInstalacionesOrtId",
        "recuerdaPublicidadOrt",
        "publicidadOrtIds"
      ]
    },
    {
      "key": "situacionLaboral",
      "label": "Situación laboral",
      "fields": [
        "trabajaActualmente",
        "tipoJornadaId"
      ]
    }
  ],
  "backendResolvedFields": [
    "idComienzo",
    "tipoDocumento",
    "documento",
    "codigoPersona",
    "idTurno",
    "tipoInscripcion",
    "claveEncuesta",
    "usuarioIngreso",
    "fechaIngreso",
    "estadoEncuesta"
  ],
  "constants": {
    "tipoInscripcion": "SOLO_ENCUESTA_INI"
  },
  "fields": {
    "carreraId": {
      "type": "number",
      "catalogEndpoint": "Catalogos/Carreras",
      "valueField": "idProducto",
      "labelField": "nombreProducto",
      "levelField": "idNivelProducto",
      "requiredForDefinitivo": true
    },
    "procesoId": {
      "type": "number",
      "catalogEndpoint": "Catalogos/Comienzos",
      "valueField": "idProceso",
      "labelField": "nombreProceso",
      "dependsOn": "carreraId",
      "requiredForDefinitivo": true
    },
    "ubicacionUltimoAnioSecundariaId": {
      "section": "educacion",
      "type": "number",
      "allowedOptions": [
        {
          "value": 1,
          "label": "Uruguay"
        },
        {
          "value": 2,
          "label": "En el exterior"
        }
      ],
      "requiredForDefinitivo": true
    },
    "institucionSecundariaId": {
      "section": "educacion",
      "type": "number",
      "catalogEndpoint": "Catalogos/Instituciones",
      "valueField": "codigoEmpresa",
      "labelField": "nombre",
      "requiredWhen": "ubicacionUltimoAnioSecundariaId == 1",
      "clearWhen": "ubicacionUltimoAnioSecundariaId == 2"
    },
    "nombreInstitucionSecundaria": {
      "section": "educacion",
      "type": "string",
      "requiredWhen": "ubicacionUltimoAnioSecundariaId == 2",
      "clearWhen": "ubicacionUltimoAnioSecundariaId == 1"
    },
    "anioBachillerato": {
      "section": "educacion",
      "type": "number",
      "catalogPath": "educacion.aniosBachillerato",
      "valueField": "value",
      "labelField": "label",
      "requiredWhen": "cursaSecundariaActualmente == true",
      "clearWhen": "cursaSecundariaActualmente == false",
      "disallowedWhen": [
        {
          "code": "INS_EI_64",
          "condition": "selectedCarrera.nivel == 1",
          "values": [4, 10],
          "message": "Para carreras universitarias, el bachillerato indicado debe ser quinto o sexto año."
        }
      ]
    },
    "cursaSecundariaActualmente": {
      "section": "educacion",
      "type": "boolean",
      "allowedOptions": [
        {
          "value": true,
          "label": "Sí"
        },
        {
          "value": false,
          "label": "No"
        }
      ],
      "requiredForDefinitivo": true
    },
    "orientacionBachilleratoId": {
      "section": "educacion",
      "type": "number",
      "catalogPath": "educacion.aniosBachillerato[].orientaciones",
      "valueField": "value",
      "labelField": "label",
      "requiredWhen": "cursaSecundariaActualmente == true && selectedAnioBachillerato.orientaciones.length > 0",
      "clearWhen": "cursaSecundariaActualmente == false"
    },
    "recursaAnioBachillerato": {
      "section": "educacion",
      "type": "boolean",
      "allowedOptions": [
        {
          "value": true,
          "label": "Sí"
        },
        {
          "value": false,
          "label": "No"
        }
      ],
      "requiredForDefinitivo": true
    },
    "vecesRecursaAnioBachillerato": {
      "section": "educacion",
      "type": "number",
      "requiredWhen": "recursaAnioBachillerato == true",
      "clearWhen": "recursaAnioBachillerato == false",
      "min": 1
    },
    "estadoEducacionSuperiorPreviaId": {
      "section": "educacion",
      "type": "number",
      "allowedOptions": [
        {
          "value": 1,
          "label": "Sí, en Uruguay"
        },
        {
          "value": 2,
          "label": "Sí, en el exterior"
        },
        {
          "value": 3,
          "label": "No"
        }
      ],
      "requiredForDefinitivo": true
    },
    "universidadEducacionSuperiorIds": {
      "section": "educacion",
      "type": "array",
      "catalogPath": "educacion.universidades",
      "itemValueField": "value",
      "itemLabelField": "label",
      "requiredWhen": "estadoEducacionSuperiorPreviaId == 1",
      "clearWhen": "estadoEducacionSuperiorPreviaId in [2, 3]",
      "minItems": 1
    },
    "universidadEducacionSuperiorOtros": {
      "section": "educacion",
      "type": "array",
      "itemType": "string",
      "requiredWhen": "universidadEducacionSuperiorIds contains 0",
      "clearWhen": "estadoEducacionSuperiorPreviaId in [2, 3]"
    },
    "nivelFormacionPadreTutorId": {
      "section": "educacion",
      "type": "number",
      "catalogPath": "educacion.nivelesFormacionTutores",
      "valueField": "value",
      "labelField": "label",
      "requiredForDefinitivo": true
    },
    "padreTutorEgresadoOrt": {
      "section": "educacion",
      "type": "boolean",
      "allowedOptions": [
        {
          "value": true,
          "label": "Sí"
        },
        {
          "value": false,
          "label": "No"
        }
      ],
      "requiredWhen": "nivelFormacionPadreTutorId in [5, 6]",
      "clearWhen": "nivelFormacionPadreTutorId not in [5, 6]"
    },
    "nivelFormacionMadreTutorId": {
      "section": "educacion",
      "type": "number",
      "catalogPath": "educacion.nivelesFormacionTutores",
      "valueField": "value",
      "labelField": "label",
      "requiredForDefinitivo": true
    },
    "madreTutorEgresadoOrt": {
      "section": "educacion",
      "type": "boolean",
      "allowedOptions": [
        {
          "value": true,
          "label": "Sí"
        },
        {
          "value": false,
          "label": "No"
        }
      ],
      "requiredWhen": "nivelFormacionMadreTutorId in [5, 6]",
      "clearWhen": "nivelFormacionMadreTutorId not in [5, 6]"
    },
    "anioDecisionCarreraId": {
      "section": "decisionAcademica",
      "type": "number",
      "catalogPath": "decisionAcademica.aniosEducacionMediaSuperior",
      "valueField": "value",
      "labelField": "label",
      "requiredForDefinitivo": true
    },
    "anioDecisionOrtId": {
      "section": "decisionAcademica",
      "type": "number",
      "catalogPath": "decisionAcademica.aniosEducacionMediaSuperior",
      "valueField": "value",
      "labelField": "label",
      "requiredForDefinitivo": true
    },
    "nivelDecisionId": {
      "section": "decisionAcademica",
      "type": "number",
      "allowedOptions": [
        {
          "value": 1,
          "label": "Decidido/a"
        },
        {
          "value": 2,
          "label": "Con dudas"
        }
      ],
      "requiredForDefinitivo": true
    },
    "seInformoEnOtrasUniversidades": {
      "section": "decisionAcademica",
      "type": "boolean",
      "allowedOptions": [
        {
          "value": true,
          "label": "Sí, lo hice"
        },
        {
          "value": false,
          "label": "No"
        }
      ],
      "requiredForDefinitivo": true
    },
    "universidadConsideradaIds": {
      "section": "decisionAcademica",
      "type": "array",
      "catalogPath": "decisionAcademica.universidades",
      "itemValueField": "value",
      "itemLabelField": "label",
      "requiredWhen": "seInformoEnOtrasUniversidades == true",
      "clearWhen": "seInformoEnOtrasUniversidades == false",
      "minItems": 1
    },
    "universidadConsideradaOtros": {
      "section": "decisionAcademica",
      "type": "array",
      "itemType": "string",
      "requiredWhen": "universidadConsideradaIds contains 0",
      "clearWhen": "seInformoEnOtrasUniversidades == false"
    },
    "informacionOtrasUniversidadesLinea1": {
      "section": "decisionAcademica",
      "type": "string",
      "requiredForDefinitivo": false
    },
    "informacionOtrasUniversidadesLinea2": {
      "section": "decisionAcademica",
      "type": "string",
      "requiredForDefinitivo": false
    },
    "apoyoDecisionId": {
      "section": "decisionAcademica",
      "type": "number",
      "catalogPath": "decisionAcademica.apoyosDecision",
      "valueField": "value",
      "labelField": "label",
      "requiredForDefinitivo": true
    },
    "motivoEleccionOrtIds": {
      "section": "decisionAcademica",
      "type": "array",
      "catalogPath": "decisionAcademica.motivosEleccionOrt",
      "itemValueField": "value",
      "itemLabelField": "label",
      "requiredForDefinitivo": true,
      "minItems": 1
    },
    "tuvoAsesoramientoOrt": {
      "section": "experienciaOrt",
      "type": "boolean",
      "allowedOptions": [
        {
          "value": true,
          "label": "Sí, tuve"
        },
        {
          "value": false,
          "label": "No"
        }
      ],
      "requiredForDefinitivo": true
    },
    "valoracionAsesoramientoOrtId": {
      "section": "experienciaOrt",
      "type": "number",
      "catalogPath": "experienciaOrt.valoraciones",
      "valueField": "value",
      "labelField": "label",
      "requiredWhen": "tuvoAsesoramientoOrt == true",
      "clearWhen": "tuvoAsesoramientoOrt == false"
    },
    "visitoSitioWebOrt": {
      "section": "experienciaOrt",
      "type": "boolean",
      "allowedOptions": [
        {
          "value": true,
          "label": "Sí, lo visité"
        },
        {
          "value": false,
          "label": "No"
        }
      ],
      "requiredForDefinitivo": true
    },
    "valoracionSitioWebOrtId": {
      "section": "experienciaOrt",
      "type": "number",
      "catalogPath": "experienciaOrt.valoraciones",
      "valueField": "value",
      "labelField": "label",
      "requiredWhen": "visitoSitioWebOrt == true",
      "clearWhen": "visitoSitioWebOrt == false"
    },
    "visitoInstalacionesOrt": {
      "section": "experienciaOrt",
      "type": "boolean",
      "allowedOptions": [
        {
          "value": true,
          "label": "Sí, lo hice"
        },
        {
          "value": false,
          "label": "No"
        }
      ],
      "requiredForDefinitivo": true
    },
    "valoracionInstalacionesOrtId": {
      "section": "experienciaOrt",
      "type": "number",
      "catalogPath": "experienciaOrt.valoraciones",
      "valueField": "value",
      "labelField": "label",
      "requiredWhen": "visitoInstalacionesOrt == true",
      "clearWhen": "visitoInstalacionesOrt == false"
    },
    "recuerdaPublicidadOrt": {
      "section": "experienciaOrt",
      "type": "boolean",
      "allowedOptions": [
        {
          "value": true,
          "label": "Sí"
        },
        {
          "value": false,
          "label": "No recuerdo"
        }
      ],
      "requiredForDefinitivo": true
    },
    "publicidadOrtIds": {
      "section": "experienciaOrt",
      "type": "array",
      "catalogPath": "experienciaOrt.publicidadesOrt",
      "itemValueField": "value",
      "itemLabelField": "label",
      "requiredWhen": "recuerdaPublicidadOrt == true",
      "clearWhen": "recuerdaPublicidadOrt == false",
      "minItems": 1
    },
    "trabajaActualmente": {
      "section": "situacionLaboral",
      "type": "boolean",
      "allowedOptions": [
        {
          "value": true,
          "label": "Sí, trabajo"
        },
        {
          "value": false,
          "label": "No"
        }
      ],
      "requiredForDefinitivo": true
    },
    "tipoJornadaId": {
      "section": "situacionLaboral",
      "type": "number",
      "catalogPath": "situacionLaboral.tiposJornada",
      "valueField": "value",
      "labelField": "label",
      "requiredWhen": "trabajaActualmente == true",
      "clearWhen": "trabajaActualmente == false"
    }
  }
}
