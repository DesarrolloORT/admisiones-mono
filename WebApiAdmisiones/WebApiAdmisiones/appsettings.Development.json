{
  "SoapSettings": {
    "ServiosOffice365Url": "https://serviciosoffice365desa.ort.edu.uy/?wsdl"
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "ApiClients": {
    "InscripcionesYPagos": {
      "BaseUrl": "http://localhost:49557/"
    }
  },
  "Telemetry": {
    "EnableMetrics": true,
    "EnableTraces": true,
    "EnableLogs": true
  },
  "AzureDocumentIntelligence": {
    "ApiVersion": "2024-11-30",
    "IdDocumentModelId": "prebuilt-idDocument",
    "ReadModelId": "prebuilt-read",
    "PollingDelayMilliseconds": 2000,
    "MaxPollingAttempts": 15,
    "PdfPages": "1",
    "DeleteAnalyzeResult": true
  },
  "AzureFace": {
    "Enabled": true,
    "DetectionModel": "detection_03"
  },
  "ReconocimientoDocumento": {
    "MaxFileBytes": 2097152,
    "RateLimitPerMinute": 5
  },
  "PasswordActivation": {
    "ExpireHours": 24,
    "SessionMinutes": 15
  },
  "AdmisionesFrontend": {
    "CrearPasswordUrl": "https://admisionesdesa.ort.edu.uy/crear-password"
  },
  "Mail": {
    "From": "admisiones@ort.edu.uy"
  },
  "OtlpServiceName": "WebApiAdmisionesDesa",
  "OtlpEndpoint": "http://metricasdesa.ort.edu.uy:4317",
  "OtlpLoki": "http://metricasdesa.ort.edu.uy:4318/v1/logs",
  "AllowedHosts": "*",
  "Serilog": {
    "Using": [
      "Serilog.Sinks.Console",
      "Serilog.Sinks.Grafana.Loki",
      "Serilog.Settings.Configuration"
    ],
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "System": "Warning",
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore": "Error",
        "Microsoft.EntityFrameworkCore.Database.Command": "Error" // corta 'Executed DbCommand'
      }
    },
    "Enrich": ["FromLogContext", "WithMachineName"]
  }
}
