{
  "SoapSettings": {
    "ServiosOffice365Url": "https://serviciosoffice365desa.ort.edu.uy/?wsdl"
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "Telemetry": {
    "EnableMetrics": true,
    "EnableTraces": true,
    "EnableLogs": true
  },
  "OtlpServiceName": "WebApiFDPDesa",
  "OtlpEndpoint": "http://metricasdesa.ort.edu.uy:4317",
  "OtlpLoki": "http://metricasdesa.ort.edu.uy:4318/v1/logs",
  "AllowedHosts": "*",
  "Serilog": {
    "Using": [ "Serilog.Sinks.Console", "Serilog.Sinks.Grafana.Loki", "Serilog.Settings.Configuration" ],
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "System": "Warning",
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore": "Error",
        "Microsoft.EntityFrameworkCore.Database.Command": "Error" // corta 'Executed DbCommand'
      }
    },
    "Enrich": [ "FromLogContext", "WithMachineName" ]
  }
}
