<?xml version="1.0" encoding="utf-8"?>
<RunSettings>
  <DataCollectionRunSettings>
    <DataCollectors>
      <DataCollector friendlyName="XPlat Code Coverage">
        <Configuration>
          <Format>cobertura,opencover</Format>
          <!-- Código generado por Devart: mismo criterio que sonar.exclusions en ci-sonarqube-tests.yml (M-25) -->
          <ExcludeByFile>**/AppLogic/DevartDTOs/**/*.cs,**/BusinessLogic/DevartEFCore/**/*.cs,**/DataAccess/DevartDataAccess/**/*.cs</ExcludeByFile>
        </Configuration>
      </DataCollector>
    </DataCollectors>
  </DataCollectionRunSettings>
</RunSettings>
