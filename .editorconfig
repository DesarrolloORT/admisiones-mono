# Editor configuration, see https://editorconfig.org
root = true

[*]
charset = utf-8
indent_style = space
indent_size = 2
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
max_line_length = 120

[*.{ts,js}]
quote_type = single
curly_bracket_next_line = false
spaces_around_operators = true
spaces_around_brackets = inside
indent_brace_style = K&R

[*.html]
indent_size = 2
quote_type = double

[*.{scss,css}]
indent_size = 2
quote_type = double

[*.json]
indent_size = 2
quote_type = double

[*.md]
max_line_length = off
trim_trailing_whitespace = false

[*.yml]
indent_size = 2

[*.xml]
indent_size = 2

# Specific for TypeScript files
[*.ts]
quote_type = single
spaces_around_operators = true
spaces_around_brackets = inside
indent_brace_style = K&R
